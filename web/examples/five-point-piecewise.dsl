# @widthMm: 60
# 닫힌 구간 [0,4]: 발문에 주어진 다섯 점을 순서대로 잇는다.
@version: "1.1.0"
@frame: x=-1.06, y=-1.00, width=6.90, height=6.20
@axes: xMin=-0.85, xMax=5.1, yMin=-0.82, yMax=5.02, showLabels=false
O: FreePoint(0,0)
A: FreePoint(1,4)
B: FreePoint(2,1)
C: FreePoint(3,4)
D: FreePoint(4,3)
# x=1,2,3,4와 y=1,2,3,4에서만 보이는 점선 격자
X: FreePoint(4,0)
Y: RotatePoint(X about O, angle=90)
X1: Projection(A onto O -> X)
X2: Projection(B onto O -> X)
X3: Projection(C onto O -> X)
T2: TranslatePoint(X2 by O -> Y)
T4: TranslatePoint(X by O -> Y)
Y1: Projection(B onto O -> Y)
Y2: MidPoint(O,Y)
Y3: Projection(D onto O -> Y)
H1: TranslatePoint(Y1 by O -> X)
H2: TranslatePoint(Y2 by O -> X)
v1: Segment(X1 -> A)
v2: Segment(X2 -> T2)
v3: Segment(X3 -> C)
v4: Segment(X -> T4)
h1: Segment(Y1 -> H1)
h2: Segment(Y2 -> H2)
h3: Segment(Y3 -> D)
h4: Segment(Y -> T4)
# 함수 그래프는 네 실선 선분이며, 양 끝을 넘어 연장하지 않는다.
a: Segment(O -> A)
b: Segment(A -> B)
c: Segment(B -> C)
d: Segment(C -> D)
---annotations---
styleV1: Annotation(v1, lineDash=[1.8,3], lineWidth=0.75, opacity=0.58)
styleV2: Annotation(v2, lineDash=[1.8,3], lineWidth=0.75, opacity=0.58)
styleV3: Annotation(v3, lineDash=[1.8,3], lineWidth=0.75, opacity=0.58)
styleV4: Annotation(v4, lineDash=[1.8,3], lineWidth=0.75, opacity=0.58)
styleH1: Annotation(h1, lineDash=[1.8,3], lineWidth=0.75, opacity=0.58)
styleH2: Annotation(h2, lineDash=[1.8,3], lineWidth=0.75, opacity=0.58)
styleH3: Annotation(h3, lineDash=[1.8,3], lineWidth=0.75, opacity=0.58)
styleH4: Annotation(h4, lineDash=[1.8,3], lineWidth=0.75, opacity=0.58)
origin: Annotation(O, label="$\mathrm{O}$", labelPosition="bottom-left", pointSize=0)
nx1: Annotation(X1, label="$1$", labelPosition="bottom", pointSize=0)
nx2: Annotation(X2, label="$2$", labelPosition="bottom", pointSize=0)
nx3: Annotation(X3, label="$3$", labelPosition="bottom", pointSize=0)
nx4: Annotation(X, label="$4$", labelPosition="bottom", pointSize=0)
ny1: Annotation(Y1, label="$1$", labelPosition="left", pointSize=0)
ny2: Annotation(Y2, label="$2$", labelPosition="left", pointSize=0)
ny3: Annotation(Y3, label="$3$", labelPosition="left", pointSize=0)
ny4: Annotation(Y, label="$4$", labelPosition="left", pointSize=0)
fLabel: Text(x=4.82, y=3.09, text="$y=f(x)$", isLatex=true)
xLabel: Text(x=5.05, y=-0.23, text="$x$", isLatex=true)
yLabel: Text(x=-0.20, y=4.97, text="$y$", isLatex=true)
