# 반원과 두 현이 정하는 넓이. 발문이 없어 θ=20°와 정삼각형 UST를 대표 구도로 선택.
@version: "1.1.0"
@frame: x=-5.8, y=-0.85, width=11.7, height=6.7
A: FreePoint(-5,0)
B: FreePoint(5,0)
O: MidPoint(A,B)
arc: Arc(center=O, start=B, end=A, direction=ccw)
AB: Segment(A -> B)
# 원주각 AP의 θ와 BQ의 2θ를 중심각 40°, 80°로 구성한다.
P: RotatePoint(B about O, angle=40)
Q: RotatePoint(A about O, angle=-80)
AP: Segment(A -> P)
BQ: Segment(B -> Q)
R: Intersect(AP,BQ,index=0)
# ABK는 아래를 향한 보조 정삼각형. R 중심 닮음으로 K를 AB 위의 S로 보낸다.
K: RotatePoint(B about A, angle=-60)
S: Intersect(AB, Line(R -> K), index=0)
leftSide: ParallelLine(S, K -> A)
rightSide: ParallelLine(S, K -> B)
U: Intersect(AP,leftSide,index=0)
T: Intersect(BQ,rightSide,index=0)
UT: Segment(U -> T)
US: Segment(U -> S)
ST: Segment(S -> T)
---annotations---
ann_O: Annotation(O, visible=false)
ann_K: Annotation(K, visible=false)
ann_left: Annotation(leftSide, visible=false)
ann_right: Annotation(rightSide, visible=false)
ann_A: Annotation(A, label="$\mathrm{A}$", labelPosition="auto", pointSize=0)
ann_B: Annotation(B, label="$\mathrm{B}$", labelPosition="auto", pointSize=0)
ann_P: Annotation(P, label="$\mathrm{P}$", labelPosition="auto", pointSize=0)
ann_Q: Annotation(Q, label="$\mathrm{Q}$", labelPosition="auto", pointSize=0)
ann_R: Annotation(R, label="$\mathrm{R}$", labelPosition="auto", pointSize=0)
ann_S: Annotation(S, label="$\mathrm{S}$", labelPosition="auto", pointSize=0)
ann_U: Annotation(U, label="$\mathrm{U}$", labelPosition="auto", pointSize=0)
ann_T: Annotation(T, label="$\mathrm{T}$", labelPosition="auto", pointSize=0)
thetaA: AngleAnnotation(B, A, P, label="$\theta$", isLatex=true, radius=44, labelOffset=56)
thetaB: AngleAnnotation(Q, B, A, label="$2\theta$", isLatex=true, radius=34, labelOffset=44)
areaF: FillRegion(seedX=-1.8, seedY=2.7, boundaries="arc AP BQ", fillColor=0, fillOpacity=0.11)
areaG: FillRegion(seedX=1.5, seedY=1.2, boundaries="UT US ST", fillColor=0, fillOpacity=0.11)
f: Text(x=-1.8, y=2.7, text="$f(\theta)$", isLatex=true)
g: Text(x=1.54, y=1.27, text="$g(\theta)$", isLatex=true)
