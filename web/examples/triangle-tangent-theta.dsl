# 그림에서 읽은 조건: BC=2, BA=1, M은 BC의 중점, MH는 BA에 수직.
# 발문 없는 재현용 각 B=52.5°. M 중심, H를 지나는 원과 AM의 교점이 D.
@version: "1.1.0"
@frame: x=-0.14, y=-0.24, width=2.29, height=1.2
B: FreePoint(0,0)
C: FreePoint(2,0)
M: MidPoint(B,C)
A: RotatePoint(M about B, angle=52.5)
BA: Segment(B -> A)
BC: Segment(B -> C)
AM: Segment(A -> M)
H: Projection(M onto B -> A)
constructionCircle: Circle(center=M, through=H)
D: Intersect(AM, constructionCircle, index=0)
J: Intersect(BC, constructionCircle, index=0)
arc: Arc(center=M, start=D, end=J, direction=ccw)
DC: Segment(D -> C)
HC: Segment(H -> C)
HM: Segment(H -> M)
E: Intersect(AM,HC,index=0)
---annotations---
circleStyle: Annotation(constructionCircle, visible=false)
hideJ: Annotation(J, pointSize=0)
ann_A: Annotation(A, label="$\mathrm{A}$", labelPosition="auto", pointSize=0)
ann_B: Annotation(B, label="$\mathrm{B}$", labelPosition="auto", pointSize=0)
ann_C: Annotation(C, label="$\mathrm{C}$", labelPosition="auto", pointSize=0)
ann_M: Annotation(M, label="$\mathrm{M}$", labelPosition="bottom", pointSize=0)
ann_H: Annotation(H, label="$\mathrm{H}$", labelPosition="auto", pointSize=0)
ann_D: Annotation(D, label="$\mathrm{D}$", labelPosition="top-right", pointSize=0)
ann_E: Annotation(E, label="$\mathrm{E}$", labelPosition="top-right", pointSize=0)
lenBA: Annotation(BA, label="$1$", labelAnchor="middle", labelSide="left", labelOffset=76)
lenBC: Annotation(BC, label="$2$", labelAnchor="middle", labelSide="right", labelOffset=118)
angleB: AngleAnnotation(C, B, A, label="$\theta$", isLatex=true, radius=28, labelOffset=18)
rightH: AngleAnnotation(B, H, M, visible=true, markKind="right", radius=18)
areaF: FillRegion(seedX=1.1, seedY=0.36, boundaries="AM DC HC", fillColor=0, fillOpacity=0.22)
areaG: FillRegion(seedX=0.765, seedY=0.275, boundaries="AM HM HC", fillColor=0, fillOpacity=0.22)
f: Text(x=1.13, y=0.375, text="$f(\theta)$", isLatex=true)
g: Text(x=0.74, y=0.30, text="$g(\theta)$", isLatex=true)
