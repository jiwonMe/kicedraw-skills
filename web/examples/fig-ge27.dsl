DJ: Segment(D -> J)
EK: Segment(E -> K)
AG: Segment(A -> G)
FL: Segment(F -> L)
HG: Segment(H -> G)
GL: Segment(G -> L)
LK: Segment(L -> K)
u: Division(L, G, m=1, n=13, kind=internal)
v: Division(L, K, m=1, n=13, kind=internal)
w: Division(L, F, m=1, n=12, kind=internal)
wu: TranslatePoint(u by L -> w)
uwu: Segment(u -> wu)
wuw: Segment(wu -> w)
wv: TranslatePoint(v by L -> w)
vwv: Segment(v -> wv)
wvw: Segment(wv -> w)
