# REP-05 · 수직 육각기둥. 꼭짓점은 정육각형 밑면에서 같은 높이만큼 올라간다.
# 원본에 실제 치수가 없어 한 변 3.595, 높이 4.44인 대표 모델을 쓴다.
# @widthMm: 100
@version: "1.1.0"
@frame: x=-2.5, y=-2.14, width=12, height=9
H: FreePoint(0, 0)
view: Scene3D(origin=H, view="orthographic", azimuth=-44, elevation=24.2)
G: Point3D(view, x=-1.7975, y=3.113361, z=0)
I: Point3D(view, x=3.595, y=0, z=0)
J: Point3D(view, x=5.3925, y=3.113361, z=0)
K: Point3D(view, x=3.595, y=6.226723, z=0)
L: Point3D(view, x=0, y=6.226723, z=0)
B: Point3D(view, x=0, y=0, z=4.44)
A: TranslatePoint(G by H -> B)
C: TranslatePoint(I by H -> B)
D: TranslatePoint(J by H -> B)
E: TranslatePoint(K by H -> B)
F: TranslatePoint(L by H -> B)
M: MidPoint(F, E)
AB: Segment(A -> B)
BC: Segment(B -> C)
CD: Segment(C -> D)
DE: Segment(D -> E)
EF: Segment(E -> F)
FA: Segment(F -> A)
HI: Segment(H -> I)
IJ: Segment(I -> J)
JK: Segment(J -> K)
