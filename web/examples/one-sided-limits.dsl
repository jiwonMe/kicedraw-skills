# @widthMm: 58
# x=-1,1에서의 함수값과 편측극한은 그림에 표시된 값. 곡선식은 형태 재현용이다.
@version: "1.1.0"
@frame: x=-2.65, y=-2.32, width=6.18, height=6.22
@axes: xMin=-2.42, xMax=3.26, yMin=-2.12, yMax=3.65, showLabels=false
LV: Function("2-1.6*(x+1)+2.4*(x+1)^2", xMin=-1.52, xMax=-1, endMark="open")
flat: Function("-1", xMin=-1, xMax=1, startMark="closed", endMark="open")
RV: Function("1+0.82*(x-1)-0.72*(x-1)^2-1.07*(x-1)^3", xMin=1, xMax=2.35, startMark="closed")
P: PointOnPath(LV, t=1)
Q: PointOnPath(flat, t=0)
R: PointOnPath(flat, t=1)
S: PointOnPath(RV, t=0)
Y2: Intersect(Line(P -> Q), Axis(x), index=0)
O: Intersect(Axis(x), Axis(y), index=0)
Y1: RotatePoint(Y2 about O, angle=-90)
Ytop: DilatePoint(Y1 about O, factor=2)
pq: Segment(P -> Q)
rs: Segment(R -> S)
p2: Segment(P -> Ytop)
s1: Segment(S -> Y1)
---annotations---
ann_P: Annotation(P, pointSize=0)
ann_Q: Annotation(Q, pointSize=0)
ann_R: Annotation(R, pointSize=0)
ann_S: Annotation(S, pointSize=0)
ann_helper: Annotation(Y2, pointSize=0)
ann_O: Annotation(O, label="$\mathrm{O}$", labelPosition="bottom-left", pointSize=0)
ann_Y1: Annotation(Y1, label="$1$", labelPosition="left", pointSize=0)
ann_Ytop: Annotation(Ytop, label="$2$", labelPosition="right", pointSize=0)
leftGuide: Annotation(pq, lineDash=[3,3], lineWidth=1)
rightGuide: Annotation(rs, lineDash=[3,3], lineWidth=1)
upperGuide: Annotation(p2, lineDash=[3,3], lineWidth=1)
lowerGuide: Annotation(s1, lineDash=[3,3], lineWidth=1)
minusX: Text(x=-1.28, y=-0.23, text="$-1$", isLatex=true)
plusX: Text(x=1.19, y=-0.23, text="$1$", isLatex=true)
minusY: Text(x=-0.26, y=-1.21, text="$-1$", isLatex=true)
y: Text(x=-0.17, y=3.57, text="$y$", isLatex=true)
x: Text(x=3.18, y=-0.17, text="$x$", isLatex=true)
f: Text(x=2.41, y=1.04, text="$y=f(x)$", isLatex=true)
