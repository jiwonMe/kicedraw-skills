# @widthMm: 62
# 2007학년도 수능: 공통 모서리 AG를 갖는 평면 AFG와 AGH.
# Point3D의 사투영을 사용한다. 단위 정육면체이며 E가 뒤쪽 밑면 꼭짓점이다.
@version: "1.1.0"
@frame: x=-0.32, y=-0.28, width=2.06, height=1.86
F: FreePoint(0,0)
G: Point3D(F, x=1, y=0, z=0)
E: Point3D(F, x=0, y=1, z=0)
H: Point3D(F, x=1, y=1, z=0)
A: Point3D(F, x=0, y=1, z=1)
B: Point3D(F, x=0, y=0, z=1)
C: Point3D(F, x=1, y=0, z=1)
D: Point3D(F, x=1, y=1, z=1)
AB: Segment(A -> B)
BC: Segment(B -> C)
CD: Segment(C -> D)
DA: Segment(D -> A)
EF: Segment(E -> F)
FG: Segment(F -> G)
GH: Segment(G -> H)
HE: Segment(H -> E)
AE: Segment(A -> E)
BF: Segment(B -> F)
CG: Segment(C -> G)
DH: Segment(D -> H)
AF: Segment(A -> F)
AG: Segment(A -> G)
AH: Segment(A -> H)
---annotations---
dimEF: Annotation(EF, lineDash=[3,3], lineWidth=0.9)
dimHE: Annotation(HE, lineDash=[3,3], lineWidth=0.9)
dimAE: Annotation(AE, lineDash=[3,3], lineWidth=0.9)
diagAF: Annotation(AF, lineDash=[4,3])
diagAG: Annotation(AG, lineDash=[4,3])
diagAH: Annotation(AH, lineDash=[4,3])
face1: FillRegion(seedX=0.49, seedY=0.40, boundaries="AF FG AG", fillColor=0, fillOpacity=0.17)
face2: FillRegion(seedX=0.99, seedY=0.56, boundaries="AG GH AH", fillColor=0, fillOpacity=0.32)
a: Annotation(A, label="$\mathrm{A}$", labelPosition="top-left", pointSize=0)
b: Annotation(B, label="$\mathrm{B}$", labelPosition="left", pointSize=0)
c: Annotation(C, label="$\mathrm{C}$", labelPosition="bottom-right", pointSize=0)
d: Annotation(D, label="$\mathrm{D}$", labelPosition="top-right", pointSize=0)
e: Annotation(E, label="$\mathrm{E}$", labelPosition="top-right", pointSize=0)
f: Annotation(F, label="$\mathrm{F}$", labelPosition="bottom", pointSize=0)
g: Annotation(G, label="$\mathrm{G}$", labelPosition="bottom", pointSize=0)
h: Annotation(H, label="$\mathrm{H}$", labelPosition="right", pointSize=0)
