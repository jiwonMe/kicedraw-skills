{
  "name": "kicedraw-gallery",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx build.ts && npm run docs:build && vite",
    "build": "tsc --noEmit && tsx build.ts && npm run docs:build && vite build",
    "docs:build": "tsx build-docs.ts",
    "docs:examples": "tsx build-docs.ts --examples",
    "typecheck": "tsc --noEmit",
    "playground:engine": "node build-playground-engine.mjs",
    "playground:test": "node --test playground-engine.test.mjs",
    "hero:generate": "tsx generate-hero.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fflate": "^0.8.3",
    "highlight.js": "11.11.1",
    "markdown-it": "15.0.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^7.3.0"
  }
}
