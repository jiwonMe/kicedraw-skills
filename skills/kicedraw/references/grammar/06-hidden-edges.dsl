# 평행투영한 정육면체: 뒤쪽 꼭짓점 D에 닿는 세 모서리만 점선
@version: "1.1.0"
A: FreePoint(0, 0)
B: Point3D(A, x=4, y=0, z=0)
C: Point3D(A, x=4, y=4, z=0)
D: Point3D(A, x=0, y=4, z=0)
E: Point3D(A, x=0, y=0, z=4)
F: Point3D(A, x=4, y=0, z=4)
G: Point3D(A, x=4, y=4, z=4)
H: Point3D(A, x=0, y=4, z=4)
AB: Segment(A -> B)
BC: Segment(B -> C)
CD: Segment(C -> D)
DA: Segment(D -> A)
EF: Segment(E -> F)
FG: Segment(F -> G)
GH: Segment(G -> H)
HE: Segment(H -> E)
AE: Segment(A -> E)
BF: Segment(B -> F)
CG: Segment(C -> G)
DH: Segment(D -> H)
---annotations---
ann_CD: Annotation(CD, visible=true, lineDash=[4,3])
ann_DA: Annotation(DA, visible=true, lineDash=[4,3])
ann_DH: Annotation(DH, visible=true, lineDash=[4,3])
