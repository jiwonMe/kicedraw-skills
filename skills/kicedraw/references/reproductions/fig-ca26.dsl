# 기저함수와 삼각 단면: 0≤x≤2에서 중점 위에 높이가 밑변에 비례하는 꼭짓점을 올린 사투영.
# @widthMm: 124
@version: "1.1.0"
@frame: x=-0.85, y=-1.1, width=12.55, height=9
floorCurve: ParametricCurve("1.23*t+0.44*sqrt((2*t+1)*exp(t)+sin(pi*t))", "-0.15*t+0.39*sqrt((2*t+1)*exp(t)+sin(pi*t))", tMin=0, tMax=3)
ridge: ParametricCurve("1.23*t+0.22*sqrt((2*t+1)*exp(t)+sin(pi*t))", "-0.15*t+1.26*sqrt((2*t+1)*exp(t)+sin(pi*t))", tMin=0, tMax=2)
x0: FreePoint(-0.5904, 0.072)
x1: FreePoint(3.813, -0.465)
xaxis: Vector(x0 -> x1)
y0: FreePoint(-0.506, -0.4485)
y1: FreePoint(5.676, 5.031)
yaxis: Vector(y0 -> y1)
A: Intersect(Line(x0 -> x1), Line(y0 -> y1), index=0)
AF: PointOnPath(floorCurve, t=0)
AT: PointOnPath(ridge, t=0)
AAT: Segment(A -> AT)
ATAF: Segment(AT -> AF)
AAF: Segment(A -> AF)
B: FreePoint(1.1562, -0.141)
BF: PointOnPath(floorCurve, t=0.3133333)
BT: PointOnPath(ridge, t=0.47)
BBT: Segment(B -> BT)
BTBF: Segment(BT -> BF)
BBF: Segment(B -> BF)
C: FreePoint(2.46, -0.3)
CF: PointOnPath(floorCurve, t=0.6666667)
CT: PointOnPath(ridge, t=1)
CCT: Segment(C -> CT)
CTCF: Segment(CT -> CF)
CCF: Segment(C -> CF)
N: VectorOffset(C, ux=-0.38, uy=-0.3368, offset=0.5077738)
Z: VectorOffset(CF, ux=3.05, uy=2.7, offset=4.0733893)
NC: Segment(N -> C)
CFZ: Segment(CF -> Z)
---annotations---
ann_AAT: Annotation(AAT, visible=true, lineWidth=2.6)
ann_ATAF: Annotation(ATAF, visible=true, lineDash=[4,3], lineWidth=1.4)
ann_AAF: Annotation(AAF, visible=true, lineWidth=2.6)
ann_BBT: Annotation(BBT, visible=true, lineWidth=2.6)
ann_BTBF: Annotation(BTBF, visible=true, lineWidth=2.6)
ann_BBF: Annotation(BBF, visible=true, lineWidth=2.6)
ann_CCT: Annotation(CCT, visible=true, lineWidth=2.6)
ann_CTCF: Annotation(CTCF, visible=true, lineWidth=2.6)
ann_CCF: Annotation(CCF, visible=true, lineWidth=2.6)
ann_xaxis: Annotation(xaxis, visible=true, lineWidth=1.2)
ann_yaxis: Annotation(yaxis, visible=true, lineWidth=1.2)
t_eq: Text(x=8.7, y=2.35, fontSize=19, text="$y=\sqrt{(2x+1)e^x+\sin{\pi x}}$", isLatex=true)
t_x: Text(x=3.65, y=-0.68, text="$x$", isLatex=true)
t_y: Text(x=5.38, y=5.22, text="$y$", isLatex=true)
t_o: Text(x=0.05, y=-0.28, text="$\mathrm{O}$", isLatex=true)
t_cut: Text(x=2.1, y=-0.87, text="$x=2$", isLatex=true)
surface: FillRegion(seedX=2.7, seedY=1, boundaries="AAT ridge CTCF CCF xaxis", fillColor=0, fillOpacity=0.16)
section: FillRegion(seedX=1.6, seedY=1, boundaries="BBT BTBF BBF", fillColor=0, fillOpacity=0.3)
